# ============================================================
# Environment configuration — copy this to .env and
# uncomment the lines for YOUR operating system.
# .env is gitignored so each student sets it locally.
# ============================================================

# ── Linux ────────────────────────────────────────────────────
# NETWORK_MODE=host
# WEBOTS_HOST=localhost

# ── Mac & Windows ────────────────────────────────────────────
NETWORK_MODE=bridge
WEBOTS_HOST=host.docker.internal


# change the above two fileds according to your OS, then put all the fields below in your .env file same directory as this file
# NETWORK_MODE=host
# WEBOTS_HOST=localhost
# NETWORK_MODE=host
# WEBOTS_CONTROLLER_URL=tcp://localhost:1234/my_robot
# USER=root
# WEBOTS_HOME=/opt/webots